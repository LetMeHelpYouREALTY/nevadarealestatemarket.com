# Site
NEXT_PUBLIC_SITE_URL=https://www.nevadarealestatemarket.com

# Google Search Console (HTML tag method)
# GSC → Settings → Ownership verification → HTML tag
# Copy only the content= value, e.g. abc123XYZ...
GOOGLE_SITE_VERIFICATION=

# Optional: Bing Webmaster Tools
BING_SITE_VERIFICATION=

# Optional: Yandex
YANDEX_SITE_VERIFICATION=

# OpenRouter / AI (optional)
OPENROUTER_API_KEY=

# Anthropic (optional)
ANTHROPIC_API_KEY=

# Follow Up Boss (optional)
FUB_API_KEY=
FUB_SYSTEM_KEY=

# Cloudflare Images (hosted storage + imagedelivery.net CDN)
# Git /public/images is the backup. Do not orange-cloud the Vercel apex.
# Upload: CLOUDFLARE_API_TOKEN (Account.Cloudflare Images:Edit) then
#   pnpm images:upload
# Delivery (set only after upload succeeds — otherwise heroes 404):
#   NEXT_PUBLIC_CF_IMAGES_HASH=byE6BTe9lNqo21V57n4aPQ
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=2cc579c1ec9e426ed585e933ebf4753b
NEXT_PUBLIC_CF_IMAGES_HASH=
NEXT_PUBLIC_CF_IMAGES_VARIANT=public
# NEXT_PUBLIC_CF_IMAGES_FLEXIBLE=true
