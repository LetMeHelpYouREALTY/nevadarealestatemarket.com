# Site
NEXT_PUBLIC_SITE_URL=https://www.nevadarealestatemarket.com

# Google Search Console (HTML tag method)
# GSC → Settings → Ownership verification → HTML tag
# Copy only the content= value, e.g. abc123XYZ...
GOOGLE_SITE_VERIFICATION=

# Optional: Bing Webmaster Tools
BING_SITE_VERIFICATION=

# Optional: Yandex
YANDEX_SITE_VERIFICATION=

# OpenRouter / AI (optional)
OPENROUTER_API_KEY=

# Anthropic (optional)
ANTHROPIC_API_KEY=

# Follow Up Boss (optional)
FUB_API_KEY=
FUB_SYSTEM_KEY=

# Cloudflare Images (optional — git /public/images is the backup)
# Upload: CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID with
#   node scripts/upload-to-cloudflare-images.mjs
# Delivery: set the Images account hash so next/image loads imagedelivery.net
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NEXT_PUBLIC_CF_IMAGES_HASH=
NEXT_PUBLIC_CF_IMAGES_VARIANT=public
# NEXT_PUBLIC_CF_IMAGES_FLEXIBLE=true
